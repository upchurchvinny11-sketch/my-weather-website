<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#07111f">
  <title>WeatherWise</title>
  <link rel="stylesheet" href="style.css">
</head>

<body>

<header class="topbar">
  <div class="brand">
    <div class="brand-icon">W</div>
    <div>
      <h1>WeatherWise</h1>
      <span>Advanced Weather Intelligence</span>
    </div>
  </div>

  <div class="search">
    <input id="locationInput" type="text" placeholder="Search location...">
    <button onclick="searchLocation()">Search</button>
  </div>
</header>

<main>

  <section class="notice">
    <strong>DEMO FORECAST CENTER</strong>
    <span>
      Forecast values shown here are demonstration data.
      Official warnings should always be checked with the National Weather Service.
    </span>
  </section>

  <section class="hero-grid">

    <div class="current-card card">
      <div class="location">
        <span id="locationName">Muncie, Indiana</span>
        <span class="status-dot"></span>
      </div>

      <div class="current-temp">
        <span id="temperature">72°</span>
        <div>
          <strong id="condition">Partly Cloudy</strong>
          <small>Feels like 71°</small>
        </div>
      </div>

      <div class="weather-stats">
        <div>
          <span>Humidity</span>
          <strong>61%</strong>
        </div>
        <div>
          <span>Wind</span>
          <strong>SW 12 mph</strong>
        </div>
        <div>
          <span>Pressure</span>
          <strong>29.92 in</strong>
        </div>
        <div>
          <span>Visibility</span>
          <strong>10 mi</strong>
        </div>
      </div>
    </div>

    <div class="risk-card card">
      <div class="card-heading">
        <div>
          <span class="eyebrow">SEVERE WEATHER</span>
          <h2>Threat Analysis</h2>
        </div>
        <span class="confidence">Demo</span>
      </div>

      <div class="risk">
        <div>
          <span>🌪️ Tornado</span>
          <strong>8%</strong>
        </div>
        <div class="bar"><i style="width:8%"></i></div>
      </div>

      <div class="risk">
        <div>
          <span>🧊 Hail</span>
          <strong>22%</strong>
        </div>
        <div class="bar"><i style="width:22%"></i></div>
      </div>

      <div class="risk">
        <div>
          <span>💨 Damaging Wind</span>
          <strong>31%</strong>
        </div>
        <div class="bar"><i style="width:31%"></i></div>
      </div>

      <div class="risk">
        <div>
          <span>🌊 Flooding</span>
          <strong>14%</strong>
        </div>
        <div class="bar"><i style="width:14%"></i></div>
      </div>

      <p class="risk-note">
        These values are demonstration percentages and are not operational forecasts.
      </p>
    </div>

  </section>

  <section class="card">
    <div class="card-heading">
      <div>
        <span class="eyebrow">FORECAST</span>
        <h2>Hourly Conditions</h2>
      </div>
    </div>

    <div class="hourly">

      <div class="hour">
        <span>Now</span>
        <b>☁️</b>
        <strong>72°</strong>
        <small>10%</small>
      </div>

      <div class="hour">
        <span>8 PM</span>
        <b>🌤️</b>
        <strong>70°</strong>
        <small>12%</small>
      </div>

      <div class="hour">
        <span>9 PM</span>
        <b>🌤️</b>
        <strong>68°</strong>
        <small>15%</small>
      </div>

      <div class="hour">
        <span>10 PM</span>
        <b>☁️</b>
        <strong>66°</strong>
        <small>18%</small>
      </div>

      <div class="hour">
        <span>11 PM</span>
        <b>🌧️</b>
        <strong>64°</strong>
        <small>32%</small>
      </div>

      <div class="hour">
        <span>12 AM</span>
        <b>🌧️</b>
        <strong>63°</strong>
        <small>41%</small>
      </div>

    </div>
  </section>

  <section class="card">
    <div class="card-heading">
      <div>
        <span class="eyebrow">EXTENDED</span>
        <h2>7-Day Forecast</h2>
      </div>
    </div>

    <div class="forecast">

      <div>
        <strong>Today</strong>
        <span>🌤️</span>
        <b>78° / 61°</b>
        <small>20% rain</small>
      </div>

      <div>
        <strong>Thursday</strong>
        <span>🌧️</span>
        <b>74° / 59°</b>
        <small>45% rain</small>
      </div>

      <div>
        <strong>Friday</strong>
        <span>⛈️</span>
        <b>76° / 62°</b>
        <small>60% storms</small>
      </div>

      <div>
        <strong>Saturday</strong>
        <span>☀️</span>
        <b>81° / 60°</b>
        <small>10% rain</small>
      </div>

      <div>
        <strong>Sunday</strong>
        <span>🌤️</span>
        <b>79° / 58°</b>
        <small>15% rain</small>
      </div>

      <div>
        <strong>Monday</strong>
        <span>🌧️</span>
        <b>73° / 57°</b>
        <small>40% rain</small>
      </div>

      <div>
        <strong>Tuesday</strong>
        <span>☀️</span>
        <b>77° / 55°</b>
        <small>5% rain</small>
      </div>

    </div>
  </section>

  <section class="two-column">

    <div class="card">
      <div class="card-heading">
        <div>
          <span class="eyebrow">AI ANALYSIS</span>
          <h2>WeatherWise AI</h2>
        </div>
        <span class="ai-status">● ONLINE</span>
      </div>

      <div class="ai-message">
        <strong>Forecast Analyst</strong>
        <p>
          I'm ready to analyze weather observations, model guidance,
          radar trends, and official forecasts once live data sources
          are connected.
        </p>
      </div>

      <div class="ai-input">
        <input id="aiQuestion" placeholder="Ask about the forecast...">
        <button onclick="askAI()">Ask</button>
      </div>

      <div id="aiResponse" class="ai-response">
        Try asking: "What could cause severe weather tonight?"
      </div>
    </div>

    <div class="card">
      <div class="card-heading">
        <div>
          <span class="eyebrow">MODEL CENTER</span>
          <h2>Forecast Guidance</h2>
        </div>
      </div>

      <div class="models">

        <div class="model">
          <div>
            <strong>GFS</strong>
            <small>Global Forecast System</small>
          </div>
          <span>Ready</span>
        </div>

        <div class="model">
          <div>
            <strong>ECMWF</strong>
            <small>European model guidance</small>
          </div>
          <span>Ready</span>
        </div>

        <div class="model">
          <div>
            <strong>NAM</strong>
            <small>North American Model</small>
          </div>
          <span>Ready</span>
        </div>

        <div class="model">
          <div>
            <strong>AI Ensemble</strong>
            <small>Multi-model analysis</small>
          </div>
          <span>Developing</span>
        </div>

      </div>
    </div>

  </section>

  <section class="card">
    <div class="card-heading">
      <div>
        <span class="eyebrow">TROPICS</span>
        <h2>Hurricane Center</h2>
      </div>
    </div>

    <div class="hurricane">
      <div class="storm-icon">🌀</div>
      <div>
        <strong>No active demonstration track</strong>
        <p>
          A future version can display official tropical cyclone
          information, model track guidance, ensemble spread,
          intensity guidance, and forecast confidence.
        </p>
      </div>
    </div>
  </section>

  <section class="card">
    <div class="card-heading">
      <div>
        <span class="eyebrow">RADAR</span>
        <h2>Weather Map</h2>
      </div>
      <button class="map-button">Open Radar</button>
    </div>

    <div class="radar-placeholder">
      <div>
        <span>RADAR MAP</span>
        <strong>Live radar integration coming next</strong>
        <small>
          This area will eventually display radar,
          warnings, storm tracks, and other layers.
        </small>
      </div>
    </div>
  </section>

</main>

<footer>
  <strong>WeatherWise</strong>
  <span>Advanced Weather Intelligence</span>
  <p>
    Weather information is for informational purposes.
    Always follow official emergency alerts and instructions.
  </p>
</footer>

<script src="app.js"></script>
</body>
</html>
 
 * {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  background: #07111f;
  color: #edf5ff;
  min-height: 100vh;
}

.topbar {
  padding: 18px 5%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  border-bottom: 1px solid rgba(255,255,255,.08);
  background: #091525;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand-icon {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  display: grid;
  place-items: center;
  background: #18395d;
  font-weight: 800;
  font-size: 22px;
}

.brand h1 {
  font-size: 20px;
}

.brand span {
  color: #8195aa;
  font-size: 11px;
}

.search {
  display: flex;
  gap: 8px;
}

.search input,
.ai-input input {
  background: #101f31;
  border: 1px solid #263a51;
  color: white;
  border-radius: 9px;
  padding: 11px 14px;
  outline: none;
}

button {
  border: 0;
  border-radius: 9px;
  padding: 11px 16px;
  background: #3478b9;
  color: white;
  font-weight: 700;
  cursor: pointer;
}

main {
  width: min(1200px, 92%);
  margin: 28px auto;
}

.notice {
  padding: 13px 16px;
  border: 1px solid #3d5065;
  background: #101e2d;
  border-radius: 10px;
  margin-bottom: 20px;
  display: flex;
  gap: 12px;
  align-items: center;
  font-size: 13px;
  color: #9fb0c2;
}

.notice strong {
  color: #e8f3ff;
}

.hero-grid,
.two-column {
  display: grid;
  grid-template-columns: 1.4fr 1fr;
  gap: 18px;
  margin-bottom: 18px;
}

.card {
  background: #0d1a2a;
  border: 1px solid #1c3046;
  border-radius: 15px;
  padding: 22px;
  margin-bottom: 18px;
  box-shadow: 0 8px 30px rgba(0,0,0,.16);
}

.location {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #a9bacb;
}

.status-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #69c68b;
}

.current-temp {
  display: flex;
  align-items: center;
  gap: 18px;
  margin: 22px 0;
}

.current-temp > span {
  font-size: 70px;
  font-weight: 800;
}

.current-temp div {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.current-temp small {
  color: #8498ad;
}

.weather-stats {
  display: grid;
  grid-template-columns: repeat(4,1fr);
  gap: 10px;
}

.weather-stats div {
  padding: 12px;
  background: #101f31;
  border-radius: 9px;
}

.weather-stats span,
.weather-stats strong {
  display: block;
}

.weather-stats span {
  color: #7890a7;
  font-size: 11px;
  margin-bottom: 5px;
}

.weather-stats strong {
  font-size: 13px;
}

.card-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}

.eyebrow {
  color: #6e9fca;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.5px;
}

h2 {
  font-size: 21px;
  margin-top: 4px;
}

.confidence,
.ai-status {
  background: #15283c;
  border-radius: 20px;
  padding: 7px 10px;
  font-size: 11px;
  color: #9eb6cc;
}

.ai-status {
  color: #71cf91;
}

.risk {
  margin: 17px 0;
}

.risk > div:first-child {
  display: flex;
  justify-content: space-between;
  font-size: 13px;
  margin-bottom: 7px;
}

.bar {
  height: 6px;
  background: #182a3d;
  border-radius: 20px;
  overflow: hidden;
}

.bar i {
  display: block;
  height: 100%;
  background: #6d9ec6;
}

.risk-note {
  color: #71869b;
  font-size: 11px;
  margin-top: 15px;
}

.hourly {
  display: flex;
  gap: 10px;
  overflow-x: auto;
}

.hour {
  min-width: 95px;
  padding: 14px;
  border-radius: 10px;
  background: #101f31;
  text-align: center;
}

.hour span,
.hour b,
.hour strong,
.hour small {
  display: block;
  margin-bottom: 8px;
}

.hour span,
.hour small {
  color: #7890a7;
  font-size: 11px;
}

.hour b {
  font-size: 23px;
}

.forecast {
  display: grid;
  grid-template-columns: repeat(7,1fr);
  gap: 8px;
}

.forecast > div {
  padding: 13px 8px;
  text-align: center;
  background: #101f31;
  border-radius: 9px;
}

.forecast strong,
.forecast span,
.forecast b,
.forecast small {
  display: block;
  margin-bottom: 8px;
}

.forecast strong,
.forecast small {
  font-size: 11px;
}

.forecast span {
  font-size: 23px;
}

.forecast small {
  color: #7890a7;
}

.ai-message {
  padding: 15px;
  border-radius: 10px;
  background: #101f31;
  margin-bottom: 13px;
}

.ai-message p,
.ai-response {
  color: #92a7bb;
  font-size: 13px;
  line-height: 1.5;
  margin-top: 8px;
}

.ai-input {
  display: flex;
  gap: 8px;
}

.ai-input input {
  width: 100%;
}

.ai-response {
  padding-top: 12px;
}

.models {
  display: flex;
  flex-direction: column;
  gap: 9px;
}

.model {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 13px;
  background: #101f31;
  border-radius: 9px;
}

.model strong,
.model small {
  display: block;
}

.model small {
  color: #71869b;
  margin-top: 4px;
  font-size: 10px;
}

.model > span {
  font-size: 10px;
  color: #7eafd4;
}

.hurricane {
  display: flex;
  gap: 18px;
  align-items: center;
  padding: 18px;
  border-radius: 11px;
  background: #101f31;
}

.storm-icon {
  font-size: 40px;
}

.hurricane p {
  color: #8499ad;
  line-height: 1.5;
  margin-top: 6px;
  font-size: 13px;
}

.radar-placeholder {
  height: 330px;
  border-radius: 12px;
  background:
    radial-gradient(circle at 50% 50%, rgba(50,130,190,.35), transparent 25%),
    radial-gradient(circle at 35% 60%, rgba(40,150,100,.3), transparent 20%),
    #08121e;
  display: grid;
  place-items: center;
  text-align: center;
}

.radar-placeholder div {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.radar-placeholder span {
  font-size: 10px;
  letter-spacing: 2px;
  color: #6f9cc0;
}

.radar-placeholder small {
  color: #74899d;
}

footer {
  text-align: center;
  padding: 35px 20px;
  border-top: 1px solid #172b40;
  color: #70859a;
}

footer strong {
  display: block;
  color: #b8c9d9;
}

footer p {
  margin-top: 10px;
  font-size: 11px;
}

@media (max-width: 800px) {

  .topbar {
    flex-direction: column;
    align-items: stretch;
  }

  .search {
    width: 100%;
  }

  .search input {
    width: 100%;
  }

  .hero-grid,
  .two-column {
    grid-template-columns: 1fr;
  }

  .weather-stats {
    grid-template-columns: repeat(2,1fr);
  }

  .forecast {
    grid-template-columns: repeat(2,1fr);
  }

  .current-temp > span {
    font-size: 55px;
  }

  .notice {
    flex-direction: column;
    align-items: flex-start;
  }
}

function searchLocation() {
  const input = document.getElementById("locationInput");
  const location = input.value.trim();

  if (!location) {
    return;
  }

  document.getElementById("locationName").textContent = location;

  alert(
    "Location search is currently a demonstration. " +
    "The next version will connect this to live weather data."
  );
}

function askAI() {
  const input = document.getElementById("aiQuestion");
  const response = document.getElementById("aiResponse");

  const question = input.value.trim();

  if (!question) {
    response.textContent = "Enter a weather question first.";
    return;
  }

  response.textContent =
    "AI analysis will be connected after live weather data and model APIs are added. " +
    "The system will eventually compare observations, official forecasts, " +
    "numerical models, and ensemble guidance before generating an explanation.";

  input.value = "";
}